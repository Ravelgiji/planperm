# Copy to .env and fill in your API key. This file is a template; .env itself
# is gitignored and never committed.

OPENAI_API_KEY=sk-your-key-here

# Model used by every agent, and the starting point of the fallback chain.
# The request allowance is PER MODEL, and the GPT-5 family gets 500 a day here
# against 50 on the 4.x models - so this is both the better default and the
# quickest way out of a 429. The app also offers a picker, and falls back
# automatically when a model is exhausted.
PLANPERM_LLM_MODEL=gpt-5.4-mini

# Optional: override the fallback order (comma-separated, first is preferred).
# PLANPERM_LLM_MODELS=gpt-5.4-mini,gpt-5.4-nano,gpt-4o-mini,gpt-4.1-mini

# Optional: an OpenAI-compatible endpoint instead of api.openai.com
# PLANPERM_LLM_BASE_URL=https://your-proxy.example.com/v1
