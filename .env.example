# Copy to .env and fill in your API key. This file is a template; .env itself
# is gitignored and never committed.

OPENAI_API_KEY=sk-your-key-here

# Model used by every agent. gpt-4.1-mini is the default because gpt-4o-mini's
# request allowance is separate and easily exhausted - the cap is per model, so
# switching here is also the quickest way out of a 429.
PLANPERM_LLM_MODEL=gpt-4.1-mini

# Optional: an OpenAI-compatible endpoint instead of api.openai.com
# PLANPERM_LLM_BASE_URL=https://your-proxy.example.com/v1
